# CND Git repository working directory (where the CND Laravel project is cloned)
GIT_WORKING_DIR=/caminho/para/cnd-working-copy

# Git configuration for commits
GIT_REPO_URL=git@gitlab.questor.com.br:timeweb/cnd.git
GIT_BRANCH=cnd-automation
GIT_USER_NAME=mcp-cnd-pipeline
GIT_USER_EMAIL=mcp@questores.com.br

# Working directory for HAR files, state JSON, and logs (outside the repo)
WORK_DIR=/caminho/para/workdir

# PHP binary to use for artisan commands
PHP_BINARY=php

# Redmine API
REDMINE_URL=https://redmine.questor.com.br
REDMINE_API_KEY=sua_chave_aqui
REDMINE_PROJECT_ID=1106
# Filtra tarefas pelo nome do responsável (grupo ou usuário)
REDMINE_ASSIGNED_TO_NAME=Questor Sistemas - Desenvolvimento Web
# ID do grupo "Questor Sistemas - Desenvolvimento Web" — origem das tarefas que o /auto processa
REDMINE_ASSIGNED_TO_ID=1062
# ID do grupo "Questor Sistemas - Analista de Negocio Web/Imobiliario" — destino quando o /auto falha
REDMINE_FAILURE_ASSIGNEE_ID=875

# Webhook do Google Chat para notificações do /auto (sucesso/falha por tarefa)
# Gerar em: Configurações do Space → Apps e integrações → Adicionar webhooks
GOOGLE_CHAT_WEBHOOK_URL=
