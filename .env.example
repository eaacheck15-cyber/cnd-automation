# Diretório onde o repo CND (Laravel) está clonado
GIT_WORKING_DIR=C:\Workspace\cnd

# Git para os commits feitos pelo pipeline_commit
GIT_REPO_URL=git@gitlab.questor.com.br:timeweb/cnd.git
GIT_BRANCH=cnd-automation
GIT_USER_NAME=mcp-cnd-pipeline
GIT_USER_EMAIL=mcp@questores.com.br

# Diretório de trabalho do MCP (HAR, PDFs capturados, fila de tarefas).
# Fica fora do repo CND. Será criado se não existir.
WORK_DIR=C:\Workspace\cnd-automation\work

# PHP binary do host (fallback se DOCKER_CONTAINER estiver vazio). Não recomendado.
PHP_BINARY=php

# Browser: false abre Chromium visível (recomendado para debug e captura de captcha);
# true roda headless (mais rápido, mas alguns portais detectam).
BROWSER_HEADLESS=false

# Docker — OBRIGATÓRIO para o pipeline_test pois a CND é Laravel 6 / PHP 7.4 e o host
# normalmente tem PHP 8+ (incompatível com Laravel 6). O container já tem PHP 7.3.33
# e monta C:\Workspace\cnd\app em /var/www/html/app.
DOCKER_CONTAINER=configs-development-app-1
DOCKER_WORKING_DIR=/var/www/html

# MongoDB do ambiente local (usado para inserir o documento na listaespera durante o teste).
MONGO_CONTAINER=configs-development-mongodb-1
MONGO_DB=questorservercnd

# Redmine API
REDMINE_URL=https://redmine.questor.com.br
REDMINE_API_KEY=sua_chave_aqui
REDMINE_PROJECT_ID=1106
# Filtra tarefas pelo nome do responsável (grupo ou usuário)
REDMINE_ASSIGNED_TO_NAME=Questor Sistemas - Desenvolvimento Web
# ID do grupo "Questor Sistemas - Desenvolvimento Web" — origem das tarefas que o /auto processa
REDMINE_ASSIGNED_TO_ID=1062
# ID do grupo "Questor Sistemas - Analista de Negocio Web/Imobiliario" — destino quando o /auto falha
REDMINE_FAILURE_ASSIGNEE_ID=875
# Único status que a fila do /auto carrega (56 = Ag. Desenv.). Vazio = não filtra (comportamento antigo).
REDMINE_NEXT_TASK_STATUS=56
# Status ignorados ao servir a próxima tarefa, separados por vírgula (59 = Em Teste — já em mãos de outro dev).
REDMINE_NEXT_TASK_SKIP_STATUSES=59

# Webhook do Google Chat para notificações do /auto (sucesso/falha por tarefa).
# Gerar em: Configurações do Space → Apps e integrações → Adicionar webhooks
# CONTÉM TOKEN — tratar como senha, nunca commitar valor real.
GOOGLE_CHAT_WEBHOOK_URL=

# ── Fallback AHK (pipeline_browser_capture_ahk) ────────────────────────────────
# Usado quando o Playwright falha 2x no mesmo portal (Cloudflare interativo,
# Flutter Web canvas, etc.). Sobe Chrome real via CDP + AutoHotkey + Tesseract OCR.
# Todos opcionais — defaults assumem instalação padrão Windows via winget.
CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
AHK_BINARY=C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe
TESSERACT_BINARY=C:\Program Files\Tesseract-OCR\tesseract.exe
